NODE_ENV=development
PORT=5000

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TMDB: https://www.themoviedb.org/settings/api  (use the "API Key (v3 auth)")
TMDB_API_KEY=

# ACRCloud: console.acrcloud.com -> Audio & Video Recognition -> your project
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Abuse / cost protection (free MVP, no accounts)
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_MUSIC_PER_HOUR=20
DAILY_GLOBAL_LIMIT=1500

# Comma-separated extra allowed origins (the extension is always allowed via chrome-extension://)
CORS_EXTRA_ORIGINS=
