{
  "manifest_version": 3,
  "name": "MedDet - Media Detector",
  "version": "0.1.0",
  "description": "Identify the movie, show or song playing in a video on YouTube, TikTok, Instagram and Facebook.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.facebook.com/*",
    "https://image.tmdb.org/*",
    "https://*.mzstatic.com/*",
    "http://localhost:5000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.instagram.com/*",
        "https://*.tiktok.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["content/platforms.js", "content/capture.js", "content/ui.js", "content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "MedDet", "default_popup": "popup/popup.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
